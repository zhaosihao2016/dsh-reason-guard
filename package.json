{
  "name": "dsh-reason-guard",
  "version": "0.1.0",
  "description": "Reasoning & fact-integrity guard for DSH. Anti-fabrication: never invent facts, citations, statistics, expert claims, versions or conclusions; mark uncertainty and refuse when honesty demands it.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19.0 || >=24"
  },
  "keywords": [
    "dsh",
    "plugin",
    "fact-check",
    "anti-fabrication",
    "honesty",
    "hallucination",
    "reasoning"
  ],
  "optionalDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}